DATABASE_URL=
# Emma's sign-in email. Set it in Railway, never commit the real address.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required. Long random string used to sign session cookies; the app refuses to start without it.
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=
# Booking alerts. Email switches on only when BOTH are set.
# RESEND_API_KEY: from resend.com > API Keys. Set it in Railway only.
RESEND_API_KEY=
# EMAIL_FROM: an address on a domain verified in Resend, e.g.
#   Soul Lifting Therapies <bookings@soulliftingtherapies.co.uk>
EMAIL_FROM=
SUMUP_API_KEY=
