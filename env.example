DATABASE_URL=
# Emma's sign-in email. Set it in Railway, never commit the real address.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Required. Long random string used to sign session cookies; the app refuses to start without it.
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=
# Booking alerts, sent over SMTP from a mailbox the business already owns.
# Email switches on only when SMTP_HOST, SMTP_USER and SMTP_PASS are all set.
# Railway allows outbound SMTP on the Pro plan only.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=the full Gmail
# address, SMTP_PASS=a Google app password (needs 2-Step Verification; it is
# revoked whenever the Google password changes). Set the password in Railway only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER. e.g. Soul Lifting Therapies <name@gmail.com>
EMAIL_FROM=
# Money tab: a secret API key Emma creates in SumUp (Settings > For Developers >
# Toolkit > API Keys). Read-only use: card takings and payout fees. Set in Railway only.
SUMUP_API_KEY=
# Optional. Looked up from the key when blank.
SUMUP_MERCHANT_CODE=
# Connections tab: unlocks the encrypted connection keys and tokens stored in the
# database. 32+ random characters. Set once in Railway; changing it disconnects everything.
CONNECTOR_SECRET=
# Sign-in connections need a developer app per provider. Leave blank to hide them.
# Each app's redirect address: https://<site>/api/connections/callback/<provider>
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
